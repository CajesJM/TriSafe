generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  LGU_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DriverVerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  EXPIRED
}

enum RideStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IncidentCategory {
  SAFETY
  OVERCHARGING
  HARASSMENT
  VEHICLE
  OTHER
}

enum IncidentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ViolationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum PenaltyStatus {
  NOT_APPLICABLE
  PENDING
  PAID
  WAIVED
}

model User {
  id              String    @id @default(cuid())
  role            UserRole
  status          UserStatus @default(ACTIVE)
  fullName        String
  username        String?   @unique
  email           String?   @unique
  phone           String?
  avatarData      String?   @db.Text
  passwordHash    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  roleDefinition  RoleDefinition @relation(fields: [role], references: [key], onDelete: Restrict, onUpdate: Cascade)
  driverProfile   Driver?
  address         UserAddress?
  passengerRides  Ride[]    @relation("PassengerRides")
  submittedRatings DriverRating[] @relation("PassengerRatings")
  incidents       Incident[]
  livePresence    LivePresence?
}

model UserAddress {
  id                String   @id @default(cuid())
  userId            String   @unique
  provinceCode      String
  provinceName      String
  municipalityCode String
  municipalityName String
  barangayCode      String
  barangayName      String
  streetPurok       String
  postalCode        String
  externalPlaceId   String
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provinceCode, municipalityCode, barangayCode])
  @@index([postalCode])
}

model RoleDefinition {
  id          String   @id @default(cuid())
  key         UserRole @unique
  name        String
  description String?
  permissions String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Driver {
  id              String   @id @default(cuid())
  userId          String   @unique
  ownerId         String?
  verification    DriverVerificationStatus @default(PENDING)
  user            User     @relation(fields: [userId], references: [id])
  owner           TransportOwner? @relation(fields: [ownerId], references: [id])
  franchise       Franchise?
  vehicles        Vehicle[]
  announcements   AnnouncementRecipient[]
  address         DriverAddress?
  violations      DriverViolation[]
  ratings         DriverRating[]
  createdAt       DateTime @default(now())
}

model TransportOwner {
  id            String   @id @default(cuid())
  identityKey   String   @unique
  lastName      String
  firstName     String
  middleName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  drivers       Driver[]
}

model DriverAddress {
  id                String   @id @default(cuid())
  driverId          String   @unique
  provinceCode      String
  provinceName      String
  municipalityCode String
  municipalityName String
  barangayCode      String
  barangayName      String
  purok             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  driver            Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([provinceCode, municipalityCode, barangayCode])
}

model Franchise {
  id              String   @id @default(cuid())
  driverId        String   @unique
  franchiseNumber String   @unique
  issuedAt        DateTime
  expiresAt       DateTime
  status          DriverVerificationStatus @default(PENDING)
  driver          Driver   @relation(fields: [driverId], references: [id])
}

model Vehicle {
  id              String   @id @default(cuid())
  driverId        String
  plateNumber     String   @unique
  vehicleType     String
  bodyNumber      String?  @unique
  permitNumber    String?  @unique
  engineNumber    String?  @unique
  chassisNumber   String?  @unique
  makeModel       String?
  isActive        Boolean  @default(true)
  driver          Driver   @relation(fields: [driverId], references: [id])
  qrCode          QrCode?
  rides           Ride[]
}

model QrCode {
  id              String   @id @default(cuid())
  vehicleId       String   @unique
  token           String   @unique
  generatedAt     DateTime @default(now())
  revokedAt       DateTime?
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Location {
  id              String   @id @default(cuid())
  name            String
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  active          Boolean  @default(true)
  fromFares       FareRule[] @relation("FromLocation")
  toFares         FareRule[] @relation("ToLocation")
}

model FareRule {
  id                  String   @id @default(cuid())
  fromLocationId      String
  toLocationId        String
  baseFare            Decimal  @db.Decimal(10, 2)
  distanceKm          Decimal  @db.Decimal(10, 2)
  perKm               Decimal  @db.Decimal(10, 2)
  passengerSurcharge  Decimal  @db.Decimal(10, 2) @default(0)
  minimumFare         Decimal  @db.Decimal(10, 2) @default(0)
  version             String
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  active              Boolean  @default(true)
  fromLocation        Location @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation          Location @relation("ToLocation", fields: [toLocationId], references: [id])
  @@index([fromLocationId, toLocationId, active])
}

model VehicleFarePolicy {
  id                  String   @id @default(cuid())
  vehicleType         String   @unique
  baseFare            Decimal  @db.Decimal(10, 2) @default(0)
  ratePerKm            Decimal  @db.Decimal(10, 2)
  minimumFare         Decimal  @db.Decimal(10, 2) @default(0)
  passengerSurcharge  Decimal  @db.Decimal(10, 2) @default(0)
  version             String
  active              Boolean  @default(true)
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([active, effectiveFrom])
}

model Ride {
  id              String   @id @default(cuid())
  passengerId     String
  vehicleId       String
  fromLocationId  String?
  toLocationId    String?
  fromLocationName String?
  toLocationName   String?
  estimatedFare   Decimal  @db.Decimal(10, 2)
  finalFare       Decimal? @db.Decimal(10, 2)
  actualDistanceMeters Float @default(0)
  passengerCount  Int      @default(1)
  vehicleType     String   @default("TRICYCLE")
  fareVersion     String
  status          RideStatus @default(ACTIVE)
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  startLatitude   Decimal? @db.Decimal(10, 7)
  startLongitude  Decimal? @db.Decimal(10, 7)
  destinationLatitude  Decimal? @db.Decimal(10, 7)
  destinationLongitude Decimal? @db.Decimal(10, 7)
  endLatitude     Decimal? @db.Decimal(10, 7)
  endLongitude    Decimal? @db.Decimal(10, 7)
  passenger       User     @relation("PassengerRides", fields: [passengerId], references: [id])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  incident        Incident?
  rating          DriverRating?
  locationPoints  RideLocationPoint[]
  @@index([passengerId, status])
}

model RideLocationPoint {
  id          String   @id @default(cuid())
  rideId      String
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  accuracy    Float?
  recordedAt  DateTime @default(now())
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, recordedAt])
}

model LivePresence {
  id          String   @id @default(cuid())
  userId      String   @unique
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  accuracy    Float?
  heading     Float?
  speed       Float?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model Incident {
  id              String   @id @default(cuid())
  passengerId     String
  rideId          String?  @unique
  rawDescription  String
  aiDraft         String?
  category        IncidentCategory @default(OTHER)
  status          IncidentStatus @default(DRAFT)
  reviewerNotes   String?
  createdAt       DateTime @default(now())
  submittedAt     DateTime?
  passenger       User     @relation(fields: [passengerId], references: [id])
  ride            Ride?    @relation(fields: [rideId], references: [id])
  @@index([status, createdAt])
}

model DriverViolation {
  id            String        @id @default(cuid())
  driverId      String
  incidentId    String?
  category      String
  description   String
  occurredAt    DateTime
  status        ViolationStatus @default(OPEN)
  penaltyAmount Decimal?      @db.Decimal(10, 2)
  penaltyStatus PenaltyStatus @default(NOT_APPLICABLE)
  dueAt         DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  driver        Driver        @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, status])
  @@index([status, penaltyStatus, dueAt])
  @@index([occurredAt])
}

model DriverRating {
  id              String   @id @default(cuid())
  driverId        String
  passengerId     String
  rideId          String   @unique
  score           Int
  comment         String?
  visible         Boolean  @default(true)
  moderationNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  passenger       User     @relation("PassengerRatings", fields: [passengerId], references: [id], onDelete: Restrict)
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Restrict)

  @@index([driverId, visible, createdAt])
  @@index([passengerId, createdAt])
}

model EmergencyContact {
  id          String  @id @default(cuid())
  name        String
  phone       String
  description String?
    active      Boolean @default(true)
    @@unique([name, phone])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  recipients  AnnouncementRecipient[]
}

model AnnouncementRecipient {
  announcementId String
  driverId       String
  readAt         DateTime?
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  driver         Driver       @relation(fields: [driverId], references: [id])
  @@id([announcementId, driverId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model WeatherSnapshot {
  id             String   @id
  locationName   String
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  temperatureC   Decimal  @db.Decimal(5, 2)
  apparentC      Decimal  @db.Decimal(5, 2)
  humidity       Int
  windKmh        Decimal  @db.Decimal(6, 2)
  weatherCode    Int
  isDay          Boolean
  observedAt     DateTime
  fetchedAt      DateTime @updatedAt
}
